PROJECT_NAME           = PLFFT
PROJECT_BRIEF          = "C interface for one-dimensional Fourier transforms"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = include/plfft.h \
                         docs/plfft.md
FILE_PATTERNS          = *.h \
                         *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = docs/plfft.md

INPUT_ENCODING         = UTF-8
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
VERBATIM_HEADERS       = NO
SHOW_INCLUDE_FILES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
SEARCHENGINE           = YES
GENERATE_TREEVIEW      = NO

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

HAVE_DOT               = NO
